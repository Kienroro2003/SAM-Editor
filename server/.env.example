NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@ep-neon-host.neon.tech/dbname?sslmode=require
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5

# Auth and authorization
AUTH_REQUIRED=false
AUTHZ_REQUIRED=false
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ISSUER=sam-editor-api
AUTH_JWT_AUDIENCE=sam-editor-client

# Workspace and IDE manager
WORKSPACE_ROOT=
WORKSPACE_MAX_READ_BYTES=262144
WORKSPACE_MAX_WRITE_BYTES=1048576
WORKSPACE_MAX_TREE_DEPTH=6
WORKSPACE_MAX_TREE_ENTRIES=5000

# Source code import storage
SOURCE_STORAGE_PROVIDER=firebase
SOURCE_IMPORT_MAX_UPLOAD_MB=512
SOURCE_STORAGE_ROOT=
SOURCE_IMPORT_TEMP_DIR=

# Firebase Storage (used when SOURCE_STORAGE_PROVIDER=firebase)
FIREBASE_STORAGE_BUCKET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SIGNED_URL_EXPIRES_SEC=3600

# Test execution engine
DEFAULT_TEST_COMMAND=npm test
TEST_TIMEOUT_MS=60000
TEST_MAX_OUTPUT_BYTES=65536
TEST_EXECUTION_MODE=local
TEST_ALLOW_CUSTOM_COMMANDS=false
TEST_ALLOWED_COMMANDS=npm test,npm run test,npm run test:coverage,pnpm test,yarn test,vitest run

# Docker sandbox for test execution
TEST_DOCKER_IMAGE=node:20-alpine
TEST_DOCKER_NETWORK=none
TEST_DOCKER_MEMORY_MB=1024
TEST_DOCKER_CPUS=1
TEST_DOCKER_READONLY_WORKSPACE=true
TEST_DOCKER_READ_ONLY_ROOT=true
TEST_DOCKER_PIDS_LIMIT=256
TEST_DOCKER_SANDBOX_TMPFS_MB=512
TEST_DOCKER_FALLBACK_TO_LOCAL=true

# Job orchestration and retry policies
JOB_SYNC_WAIT_TIMEOUT_MS=30000
JOB_RESULT_TTL_MS=3600000
JOB_MAX_STORED=2000

# AI queue controls
AI_QUEUE_CONCURRENCY=1
AI_QUEUE_MAX_ATTEMPTS=3
AI_QUEUE_RETRY_BASE_MS=500
AI_QUEUE_RATE_LIMIT_MAX=30
AI_QUEUE_RATE_LIMIT_WINDOW_MS=60000
AI_HTTP_RATE_LIMIT_MAX=20
AI_HTTP_RATE_LIMIT_WINDOW_MS=60000

# Test execution queue controls
TEST_QUEUE_CONCURRENCY=1
TEST_QUEUE_MAX_ATTEMPTS=2
TEST_QUEUE_RETRY_BASE_MS=1000
TEST_QUEUE_RATE_LIMIT_MAX=10
TEST_QUEUE_RATE_LIMIT_WINDOW_MS=60000
TEST_HTTP_RATE_LIMIT_MAX=10
TEST_HTTP_RATE_LIMIT_WINDOW_MS=60000

# AI integration
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=12000
AI_ALLOW_FALLBACK=true
AI_ALLOW_EXTERNAL_REQUESTS_IN_TEST=false
